SUPABASE_URL=https://your-project.supabase.co
# Service role key is preferred (bypasses RLS reliably); falls back to the
# anon key below if you'd rather reuse the frontend's — RLS is wide open
# right now anyway (see supabase/schema.sql), so either works.
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=your-anon-key

FACE_MODEL=buffalo_sc
DET_SIZE=960
CORS_ORIGINS=http://localhost:5173
